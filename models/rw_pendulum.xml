<mujoco model="rw_pendulum">
  <option timestep="0.001"/>
  <worldbody>
    <light pos="0 0 3"/>
    <geom type="plane" size="1 1 0.1" rgba=".9 .9 .9 1"/>
    <body name="pole" pos="0 0 0.1">
      <joint name="pivot" type="hinge" axis="0 1 0" damping="0.001"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.3" size="0.015" mass="0.15"/>
      <body name="wheel" pos="0 0.03 0.3">
        <joint name="wheel" type="hinge" axis="0 1 0" damping="0.0001"/>
        <geom type="cylinder" fromto="0 -0.005 0 0 0.005 0" size="0.08" mass="0.2" rgba=".8 .3 .2 1"/>
        <geom type="box" pos="0.05 0 0" size="0.02 0.006 0.005" mass="0.001" rgba="0 0 0 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="wheel_motor" joint="wheel" gear="1" ctrlrange="-0.5 0.5"/>
  </actuator>
</mujoco>